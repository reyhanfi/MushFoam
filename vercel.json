{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/css/:path*", "destination": "/css/:path*" },
    { "source": "/js/:path*",  "destination": "/js/:path*" },
    { "source": "/:file.:ext", "destination": "/:file.:ext" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
